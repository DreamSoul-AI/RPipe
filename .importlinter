[importlinter]
root_package = rpipe

[importlinter:contract:mechanisms-do-not-know-flow]
name = Structure does not depend on flow or public assembly
type = forbidden
source_modules =
    rpipe.structure
forbidden_modules =
    rpipe.flow
    rpipe.api

[importlinter:contract:pure-contracts]
name = Configuration contracts have no implementation dependency
type = forbidden
source_modules =
    rpipe.structure.contracts
forbidden_modules =
    rpipe.structure.plan
    rpipe.structure.execution
    rpipe.structure.artifacts
    rpipe.structure.readout
    rpipe.structure.comparison
    rpipe.structure.data
    rpipe.structure.model
    rpipe.structure.algorithm
    rpipe.structure.system

[importlinter:contract:pure-plan]
name = Pure planning only depends on contracts
type = forbidden
source_modules =
    rpipe.structure.plan
forbidden_modules =
    rpipe.structure.execution
    rpipe.structure.artifacts
    rpipe.structure.readout
    rpipe.structure.comparison
    rpipe.structure.data
    rpipe.structure.model
    rpipe.structure.algorithm
    rpipe.structure.system

[importlinter:contract:readonly-does-not-execute]
name = Readout does not acquire execution or scientific components
type = forbidden
source_modules =
    rpipe.structure.readout
forbidden_modules =
    rpipe.structure.execution
    rpipe.structure.comparison
    rpipe.structure.data
    rpipe.structure.model
    rpipe.structure.algorithm
    rpipe.structure.system
